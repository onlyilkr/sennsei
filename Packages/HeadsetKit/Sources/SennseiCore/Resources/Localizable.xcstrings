    "error.bluetooth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn Bluetooth on, make sure the headphones are connected to this Mac, then reconnect. Also check that Sennsei is allowed to use Bluetooth in System Settings > Privacy & Security."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth'u açın, kulaklığın bu Mac'e bağlı olduğundan emin olun, sonra yeniden bağlanın. Ayrıca Sennsei'nin Sistem Ayarları > Gizlilik ve Güvenlik bölümünde Bluetooth kullanmasına izin verildiğini kontrol edin."
          }
        }
      }
    },
    "error.link": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection to the headphones was lost"
