    "error.connect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sennsei could not open a connection to the headphones. Make sure they are on, connected to this Mac and not in use by another app, then try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sennsei kulaklıkla bağlantı kuramadı. Kulaklığın açık, bu Mac'e bağlı ve başka bir uygulama tarafından kullanılmıyor olduğundan emin olun, sonra yeniden deneyin."
          }
        }
      }
