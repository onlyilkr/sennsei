cask "sennsei" do
  version "__VERSION__"
  sha256 "__SHA256__"

  url "https://github.com/onlyilkr/sennsei/releases/download/v#{version}/Sennsei-#{version}.zip"
  name "Sennsei"
  desc "Menu bar control for Sennheiser ACCENTUM headphones (unofficial)"
  homepage "https://github.com/onlyilkr/sennsei"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on macos: :sonoma

  app "Sennsei.app"
  # The command line tool lives inside the app bundle, covered by its signature.
  binary "#{appdir}/Sennsei.app/Contents/Resources/sennsei"

  # The app is ad-hoc signed, not notarized, so the quarantine flag is cleared after
  # install; without that, Gatekeeper refuses to open it.
  postflight_steps do
    run "/usr/bin/xattr", args:         ["-dr", "com.apple.quarantine", "{{appdir}}/Sennsei.app"],
                          must_succeed: false
  end

  uninstall quit: "io.github.onlyilkr.sennsei"

  zap trash: [
    "~/Library/Application Support/Sennsei",
    "~/Library/Preferences/io.github.onlyilkr.sennsei.plist",
  ]

  caveats <<~EOS
    Sennsei is signed ad hoc, not notarized. macOS ties the Bluetooth permission to that
    signature, so it asks again after every update: allow it again under System Settings >
    Privacy & Security > Bluetooth.

    Universal binary. The Intel (x86_64) slice is built but has not been tested on an Intel Mac; please report problems.

    The command line tool is linked as `sennsei`. It talks to the running app, so start
    Sennsei first.
  EOS
end
